DJANGO_SECRET_KEY=replace-with-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hidden owner-only admin URL path
ADMIN_URL_PATH=studio-portal-9x2k/

# Supabase Postgres (leave blank for local SQLite development)
# Production serverless (Supavisor Transaction Pooler, port 6543):
DATABASE_URL=
# Migrations (Direct or Session Pooler, port 5432):
DIRECT_DATABASE_URL=
USE_DIRECT_DB=False

# Supabase S3-Compatible Storage (leave blank to use local /media/ folder in dev)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_BUCKET=portfolio-media
SUPABASE_S3_REGION=us-east-1
# Optional public CDN base (e.g. <PROJECT_REF>.supabase.co/storage/v1/object/public/portfolio-media)
SUPABASE_PUBLIC_DOMAIN=